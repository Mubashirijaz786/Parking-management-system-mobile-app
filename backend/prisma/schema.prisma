generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  OVERDUE
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  OTHER
}

enum ReferralStatus {
  AVAILABLE
  CLAIMED
  PENDING_VERIFICATION
  VERIFIED
  REWARD_ISSUED
  REJECTED
}

model AdminUser {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  displayName     String
  role            AdminRole           @default(SUPER_ADMIN)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  auditLogs       AdminAuditLog[]
  payments        Payment[]
  createdLicenses LicenseIssuance[]   @relation("LicenseIssuedBy")
  adjustments     PaymentAdjustment[]
}

model Customer {
  id             String                      @id @default(cuid())
  customerCode   String                      @unique
  fullName       String
  businessName   String
  phone          String
  whatsapp       String?
  city           String
  address        String?
  status         CustomerStatus              @default(ACTIVE)
  registeredAt   DateTime                    @default(now())
  archivedAt     DateTime?
  devices        CustomerDevice[]
  subscriptions  Subscription[]
  licenses       LicenseIssuance[]
  activationAcks ActivationAcknowledgement[]
  invoices       Invoice[]
  payments       Payment[]
  referrals      ReferralCode[]
  claims         ReferralClaim[]             @relation("ClaimedByCustomer")
  auditLogs      AdminAuditLog[]
}

model CustomerDevice {
  id                  String                      @id @default(cuid())
  customerId          String
  deviceIdentifier    String                      @unique
  label               String?
  active              Boolean                     @default(true)
  activationStatus    String                      @default("NOT_ACTIVATED")
  activatedAt         DateTime?
  lastAcknowledgedAt  DateTime?
  activationPublicKey String?
  createdAt           DateTime                    @default(now())
  customer            Customer                    @relation(fields: [customerId], references: [id])
  licenses            LicenseIssuance[]
  activationAcks      ActivationAcknowledgement[]

  @@index([customerId])
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  validityDays  Int
  price         Decimal        @db.Decimal(12, 2)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id            String              @id @default(cuid())
  customerId    String
  planId        String
  status        SubscriptionStatus  @default(ACTIVE)
  price         Decimal             @db.Decimal(12, 2)
  discount      Decimal             @default(0) @db.Decimal(12, 2)
  startsAt      DateTime
  expiresAt     DateTime
  renewalStatus String              @default("PENDING")
  createdAt     DateTime            @default(now())
  customer      Customer            @relation(fields: [customerId], references: [id])
  plan          SubscriptionPlan    @relation(fields: [planId], references: [id])
  invoices      Invoice[]
  licenses      LicenseIssuance[]
  payments      Payment[]
  adjustments   PaymentAdjustment[]

  @@index([customerId, expiresAt])
  @@index([status, expiresAt])
}

model LicenseIssuance {
  id               String                      @id @default(cuid())
  licenseId        String                      @unique
  customerId       String
  deviceId         String
  subscriptionId   String
  issuedById       String
  signedPayload    String                      @db.Text
  issuedAt         DateTime                    @default(now())
  startsAt         DateTime
  expiresAt        DateTime
  revokedAt        DateTime?
  customer         Customer                    @relation(fields: [customerId], references: [id])
  device           CustomerDevice              @relation(fields: [deviceId], references: [id])
  subscription     Subscription                @relation(fields: [subscriptionId], references: [id])
  issuedBy         AdminUser                   @relation("LicenseIssuedBy", fields: [issuedById], references: [id])
  acknowledgements ActivationAcknowledgement[]

  @@index([customerId, expiresAt])
}

model Invoice {
  id             String              @id @default(cuid())
  invoiceNumber  String              @unique
  customerId     String
  subscriptionId String
  amount         Decimal             @db.Decimal(12, 2)
  discount       Decimal             @default(0) @db.Decimal(12, 2)
  dueAt          DateTime
  status         PaymentStatus       @default(UNPAID)
  createdAt      DateTime            @default(now())
  customer       Customer            @relation(fields: [customerId], references: [id])
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id])
  payments       Payment[]
  adjustments    PaymentAdjustment[]
  referralRewards ReferralReward[]   @relation("RewardAppliedInvoice")

  @@index([customerId, status])
}

model Payment {
  id             String              @id @default(cuid())
  paymentId      String              @unique
  customerId     String
  subscriptionId String?
  invoiceId      String?
  amount         Decimal             @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus       @default(PAID)
  transactionRef String?
  notes          String?
  recordedById   String
  paidAt         DateTime            @default(now())
  customer       Customer            @relation(fields: [customerId], references: [id])
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id])
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id])
  recordedBy     AdminUser           @relation(fields: [recordedById], references: [id])
  adjustments    PaymentAdjustment[]

  @@index([customerId, paidAt])
}

model ReferralCode {
  id         String          @id @default(cuid())
  code       String          @unique
  customerId String
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  customer   Customer        @relation(fields: [customerId], references: [id])
  claims     ReferralClaim[]
}

model ReferralClaim {
  id          String          @id @default(cuid())
  codeId      String
  claimedById String
  status      ReferralStatus  @default(CLAIMED)
  claimedAt   DateTime        @default(now())
  code        ReferralCode    @relation(fields: [codeId], references: [id])
  claimedBy   Customer        @relation("ClaimedByCustomer", fields: [claimedById], references: [id])
  reward      ReferralReward?

  @@unique([codeId, claimedById])
}

model ReferralReward {
  id              String         @id @default(cuid())
  claimId         String         @unique
  amount          Decimal        @db.Decimal(12, 2)
  status          ReferralStatus @default(PENDING_VERIFICATION)
  issuedAt        DateTime?
  appliedAt       DateTime?
  appliedInvoiceId String?
  claim           ReferralClaim  @relation(fields: [claimId], references: [id])
  appliedInvoice  Invoice?       @relation("RewardAppliedInvoice", fields: [appliedInvoiceId], references: [id])

  @@index([status, appliedAt])
}

model ActivationAcknowledgement {
  id                String          @id @default(cuid())
  acknowledgementId String          @unique
  licenseId         String
  deviceId          String
  payload           String          @db.Text
  receivedAt        DateTime        @default(now())
  confirmedAt       DateTime?
  license           LicenseIssuance @relation(fields: [licenseId], references: [id])
  device            CustomerDevice  @relation(fields: [deviceId], references: [id])
  customer          Customer?       @relation(fields: [customerId], references: [id])
  customerId        String?

  @@index([deviceId, receivedAt])
}

model PaymentAdjustment {
  id             String        @id @default(cuid())
  adjustmentId   String        @unique
  paymentId      String?
  invoiceId      String?
  amount         Decimal       @db.Decimal(12, 2)
  reason         String
  createdById    String
  createdAt      DateTime      @default(now())
  payment        Payment?      @relation(fields: [paymentId], references: [id])
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  createdBy      AdminUser     @relation(fields: [createdById], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  @@index([invoiceId, createdAt])
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminId    String
  customerId String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([createdAt])
}

model AdminNotification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}
